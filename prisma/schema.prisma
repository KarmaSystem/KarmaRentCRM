generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetCategory {
  MOTORCYCLE
  SCOOTER
  CAR
  REAL_ESTATE
  OTHER
}

enum AssetStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  UNAVAILABLE
  ARCHIVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PAID
  ACTIVE
  COMPLETED
  CANCELLED
  TECHNICAL
}

enum PaymentType {
  RENTAL
  DEPOSIT
  DEPOSIT_RETURN
  REFUND
  EXPENSE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum ExpenseCategory {
  MAINTENANCE
  REPAIR
  WASH
  FUEL
  INSURANCE
  PARTS
  TAX
  OTHER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
}

enum CommissionType {
  PERCENT
  FIXED
}

enum ContactChannel {
  PHONE
  WHATSAPP
  TELEGRAM
}

model User {
  id            String         @id @default(cuid())
  telegramId    BigInt         @unique @map("telegram_id")
  companyName   String?        @map("company_name")
  timezone      String         @default("Asia/Bangkok")
  role          UserRole       @default(OWNER)
  permissions   Json?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  assets        Asset[]
  bookings      Booking[]
  payments      Payment[]
  expenses      Expense[]
  blocks        AssetBlock[]
  notifications Notification[]
  partners      Partner[]
  acts          HandoverAct[]
  teamMembers   TeamMember[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Asset {
  id                 String        @id @default(cuid())
  userId             String        @map("user_id")
  name               String
  category           AssetCategory
  brand              String?
  model              String?
  registrationNumber String?       @map("registration_number")
  dailyRate          Decimal       @map("daily_rate") @db.Decimal(12, 2)
  description        String?
  imageUrl           String?       @map("image_url")
  status             AssetStatus   @default(AVAILABLE)
  sortOrder          Int           @default(0) @map("sort_order")
  statusColor        String        @default("#50b8ed") @map("status_color")
  currentMileage     Int?          @map("current_mileage")
  serviceMileage     Int?          @map("service_mileage")
  serviceNote        String?       @map("service_note")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings           Booking[]
  expenses           Expense[]
  blocks             AssetBlock[]

  @@index([userId, sortOrder])
  @@index([userId, status])
  @@index([userId, serviceMileage])
  @@index([userId, category])
  @@map("assets")
}

model Partner {
  id              String         @id @default(cuid())
  userId          String         @map("user_id")
  name            String
  contactName     String?        @map("contact_name")
  phone           String?
  contactChannel  ContactChannel @default(PHONE) @map("contact_channel")
  email           String?
  commissionType  CommissionType @map("commission_type")
  commissionValue Decimal        @map("commission_value") @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@index([userId, name])
  @@map("partners")
}

model Booking {
  id                 String        @id @default(cuid())
  userId             String        @map("user_id")
  assetId            String        @map("asset_id")
  partnerId          String?       @map("partner_id")
  clientName         String        @map("client_name")
  clientPhone        String        @map("client_phone")
  startDate          DateTime      @map("start_date")
  endDate            DateTime      @map("end_date")
  startTime          String        @default("12:00") @map("start_time")
  endTime            String        @default("12:00") @map("end_time")
  dailyRate          Decimal       @map("daily_rate") @db.Decimal(12, 2)
  totalPrice         Decimal       @map("total_price") @db.Decimal(12, 2)
  paidAmount         Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  depositAmount      Decimal       @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  depositCurrency    String        @default("₫") @map("deposit_currency")
  passportPhoto      Boolean       @default(false) @map("passport_photo")
  mileageLimitPerDay Int?          @map("mileage_limit_per_day")
  phoneHolder        String?       @map("phone_holder")
  helmetCount        Int?          @map("helmet_count")
  mileageAtHandover  Int?          @map("mileage_at_handover")
  fuelLevel          String?       @map("fuel_level")
  notes              String?
  status             BookingStatus @default(PENDING)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset              Asset         @relation(fields: [assetId], references: [id], onDelete: Restrict)
  partner            Partner?      @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  payments           Payment[]
  act                HandoverAct?

  @@index([userId, startDate, endDate])
  @@index([assetId, startDate, endDate])
  @@index([userId, status])
  @@map("bookings")
}

model HandoverAct {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  bookingId   String   @unique @map("booking_id")
  publicToken String   @unique @default(cuid()) @map("public_token")
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("handover_acts")
}

model Payment {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  bookingId     String?       @map("booking_id")
  amount        Decimal       @db.Decimal(12, 2)
  paymentType   PaymentType   @map("payment_type")
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  paymentDate   DateTime      @default(now()) @map("payment_date")
  comment       String?
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking       Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, paymentDate])
  @@map("payments")
}

model Expense {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  assetId   String?         @map("asset_id")
  amount    Decimal         @db.Decimal(12, 2)
  category  ExpenseCategory
  date      DateTime        @default(now())
  comment   String?
  createdAt DateTime        @default(now()) @map("created_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset     Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, category])
  @@map("expenses")
}

model AssetBlock {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  assetId   String   @map("asset_id")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  reason    String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, startDate, endDate])
  @@map("asset_blocks")
}

model Notification {
  id          String             @id @default(cuid())
  userId      String             @map("user_id")
  type        String
  referenceId String?            @map("reference_id")
  scheduledAt DateTime           @map("scheduled_at")
  sentAt      DateTime?          @map("sent_at")
  status      NotificationStatus @default(PENDING)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, referenceId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("notifications")
}

model TeamMember {
  id                String   @id @default(cuid())
  ownerId           String   @map("owner_id")
  telegramId        BigInt?  @unique @map("telegram_id")
  name              String
  phone             String?
  email             String?
  passwordHash      String?  @map("password_hash")
  commissionPercent Decimal  @default(0) @map("commission_percent") @db.Decimal(5, 2)
  role              UserRole @default(MANAGER)
  permissions       Json?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, active])
  @@index([ownerId, email])
  @@map("team_members")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  actorName String   @map("actor_name")
  actorRole String?  @map("actor_role")
  entity    String
  entityId  String   @map("entity_id")
  action    String
  reason    String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entity, entityId, createdAt])
  @@map("audit_logs")
}
